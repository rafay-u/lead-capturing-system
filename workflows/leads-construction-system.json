        "jsonBody": "={\n  \"phoneNumberId\": \"YOUR_VAPI_PHONE_NUMBER_ID\",\n  \"customer\": { \"number\": \"+1 XXX-XXX-XXXX\", \"name\": \"{{ $json['Business Name'] }}\" },\n  \"assistant\": {\n    \"name\": \"Automation Pitch Agent\",\n    \"firstMessage\": \"Hi, is this {{ $json['Decision Maker Name'] || $json['Business Name'] }}? I'm calling about {{ $json['Business Name'] }} — got 30 seconds?\",\n    \"model\": {\n      \"provider\": \"groq\",\n      \"model\": \"llama-3.3-70b-versatile\",\n      \"systemPrompt\": \"You are a friendly, concise cold-outreach voice agent for an n8n workflow automation consultancy. You are calling {{ $json['Business Name'] }} ({{ $json['Category'] }}). Research on this lead: {{ $json['Research Summary'] }}. Their likely wasted-time manual work: {{ $json['Wasted Time Manual Work'] }}. Pain points: {{ $json['Pain Points'] }}. Open by naming the specific manual/repetitive task their industry usually struggles with, explain in one sentence how automation removes it, and offer a free 15-min call. Be brief, natural, not salesy. If they say not interested, thank them and end the call politely.\"\n    },\n    \"voice\": { \"provider\": \"11labs\", \"voiceId\": \"Q0Et7LOU7VpeoeCRQAVS\" }\n  }\n}",
        "options": {}
      },
