    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json ?? {};\n\nlet raw = input.text || input.output || '';\n\nraw = String(raw)\n  .replace(/^```json\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet data;\n\ntry {\n  data = JSON.parse(raw);\n} catch (e) {\n  const leadName = input['Business Name'] || 'there';\n\n  data = {\n    subject: `Quick question about ${leadName}`,\n    body: raw\n  };\n}\n\nreturn [\n  {\n    json: data\n  }\n];"
      },
