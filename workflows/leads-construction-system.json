    {
      "parameters": {
        "jsCode": "const results = ($input.first().json.features || []).slice(0, 20);\n\nreturn results.map(r => {\n  const p = r.properties;\n  return { json: {\n    businessName: p.name || '',\n    phone: p.phone || (p.contact && p.contact.phone) || '',\n    website: p.website || (p.datasource && p.datasource.raw && p.datasource.raw.website) || '',\n    email: p.email || (p.datasource && p.datasource.raw && p.datasource.raw.email) || '',\n    address: p.formatted || '',\n    city: $('Build Search Query').first().json.city,\n    country: $('Build Search Query').first().json.country,\n    category: (p.categories || []).join(', '),\n    place_id: p.place_id,\n    sourceQuery: $('Build Search Query').first().json.searchQuery\n  }};\n});"
      },
